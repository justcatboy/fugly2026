const links = [
  { href: 'https://t.me/fuglytatt', icon: icons.telegram, label: 'тг канал' },
  { href: 'https://t.me/fuglyluv', icon: icons.telegram, label: 'тг личка' },
  { href: 'https://www.tiktok.com/@fugly8182', icon: icons.tiktok, label: 'tiktok' },
  { href: 'https://www.instagram.com/fuglytatt', icon: icons.instagram, label: 'instagram' },
]

const months = Array.from({ length: 12 }, (_, i) => `2026-${i + 1}.jpg`)
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>fugly | календарь 2026</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
  </head>
  <body>
    <header>
      <h2 style="text-align: center">Забавный календарь на 2026 год</h2>
      <nav style="display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap">
        {links.map((link) => (
          <a href={link.href} style="display: flex; align-items: center" target="_blank">
            <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d={link.icon} /></svg>
            {link.label}
          </a>
        ))}
      </nav>
    </header>

    <main>
      <div class="image-container">
        {months.map((file) => (
          <a href={`/2026/${file}`} download>
            <img src={`/2026/${file}`} style="margin-bottom: 0" alt={file} />
          </a>
        ))}
      </div>
      <div class="image-container">
        <a href="/2026/2026.jpg" style="grid-column: 2" download>
          <img src="/2026/2026.jpg" alt="2026" style="margin-bottom: 0" />
        </a>
      </div>
    </main>

    <footer>
      <div style="display: flex; justify-content: space-between; flex-wrap: wrap">
        <span></span>
        <a href="https://github.com/oxalorg/sakura">sakura</a>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  a {
    border-bottom: 0 !important;
  }

  .icon {
    width: 1em;
    height: 1em;
    margin-right: 0.6rem;
  }

  .image-container {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-top: 2rem;
  }

  @media (max-width: 560px) {
    .image-container {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
